{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/squashfs-delta-forensics-studio/report.schema.json",
  "title": "SquashFS Delta Forensics Studio Report",
  "type": "object",
  "required": [
    "summary",
    "files",
    "fragments",
    "movement_graph",
    "blast_radius",
    "reuse_opportunities",
    "root_causes",
    "heatmap_data",
    "executive_summary",
    "parser_validation",
    "data_confidence",
    "relationship_graph",
    "debug_dataset",
    "warnings",
    "offset_analysis"
  ],
  "properties": {
    "summary": {
      "type": "object",
      "required": [
        "total_files",
        "unchanged_files",
        "modified_files",
        "moved_files",
        "added_files",
        "deleted_files",
        "total_fragments",
        "changed_fragments",
        "fragment_reuse_ratio",
        "potential_reuse_loss",
        "reuse_candidates",
        "has_real_file_paths",
        "has_fragment_membership",
        "analysis_mode",
        "fragment_membership_message"
      ],
      "properties": {
        "total_files": { "type": "integer", "minimum": 0 },
        "unchanged_files": { "type": "integer", "minimum": 0 },
        "modified_files": { "type": "integer", "minimum": 0 },
        "moved_files": { "type": "integer", "minimum": 0 },
        "added_files": { "type": "integer", "minimum": 0 },
        "deleted_files": { "type": "integer", "minimum": 0 },
        "total_fragments": { "type": "integer", "minimum": 0 },
        "changed_fragments": { "type": "integer", "minimum": 0 },
        "fragment_reuse_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "potential_reuse_loss": { "type": "number", "minimum": 0, "maximum": 100 },
        "reuse_candidates": { "type": "integer", "minimum": 0 },
        "has_real_file_paths": { "type": "boolean" },
        "has_fragment_membership": { "type": "boolean" },
        "analysis_mode": { "type": "string" },
        "fragment_membership_message": { "type": "string" },
        "membership_status": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "old_size",
          "new_size",
          "old_fragment",
          "new_fragment",
          "old_blocks",
          "new_blocks",
          "same_size",
          "same_fragment",
          "status",
          "impact_score",
          "reuse_score",
          "directly_changed",
          "root_cause",
          "root_cause_confidence",
          "neighbors_old",
          "neighbors_new",
          "data_confidence",
          "source_old_file",
          "source_old_line",
          "source_old_rule",
          "source_new_file",
          "source_new_line",
          "source_new_rule",
          "synthetic"
        ],
        "properties": {
          "path": { "type": "string" },
          "old_size": { "type": ["integer", "null"], "minimum": 0 },
          "new_size": { "type": ["integer", "null"], "minimum": 0 },
          "old_fragment": { "type": ["string", "null"] },
          "new_fragment": { "type": ["string", "null"] },
          "old_blocks": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "new_blocks": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "same_size": { "type": "boolean" },
          "same_fragment": { "type": "boolean" },
          "status": { "type": "string" },
          "impact_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "reuse_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "directly_changed": { "type": "boolean" },
          "root_cause": { "type": "string" },
          "root_cause_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "neighbors_old": { "type": "array", "items": { "type": "string" } },
          "neighbors_new": { "type": "array", "items": { "type": "string" } },
          "data_confidence": { "type": "string" },
          "source_old_file": { "type": ["string", "null"] },
          "source_old_line": { "type": ["integer", "null"], "minimum": 0 },
          "source_old_rule": { "type": ["string", "null"] },
          "source_new_file": { "type": ["string", "null"] },
          "source_new_line": { "type": ["integer", "null"], "minimum": 0 },
          "source_new_rule": { "type": ["string", "null"] },
          "synthetic": { "type": "boolean" },
          "old_start_offset": { "type": ["integer", "null"], "minimum": 0 },
          "new_start_offset": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fragment_id",
          "file_count",
          "old_file_list",
          "new_file_list",
          "added_files",
          "removed_files",
          "retained_files",
          "compressed_size_old",
          "compressed_size_new",
          "status",
          "change_reason",
          "reuse_score",
          "churn_ratio",
          "membership_available",
          "membership_message",
          "old_offset_range",
          "new_offset_range",
          "overlapping_files_old",
          "overlapping_files_new",
          "overlap_confidence_score",
          "inference_method"
        ],
        "properties": {
          "fragment_id": { "type": "string" },
          "file_count": { "type": "integer", "minimum": 0 },
          "old_file_list": { "type": "array", "items": { "type": "string" } },
          "new_file_list": { "type": "array", "items": { "type": "string" } },
          "added_files": { "type": "array", "items": { "type": "string" } },
          "removed_files": { "type": "array", "items": { "type": "string" } },
          "retained_files": { "type": "array", "items": { "type": "string" } },
          "compressed_size_old": { "type": ["integer", "null"], "minimum": 0 },
          "compressed_size_new": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "type": "string" },
          "change_reason": { "type": "string" },
          "reuse_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "churn_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
          "membership_available": { "type": "boolean" },
          "membership_message": { "type": "string" },
          "old_offset_range": { "type": ["string", "null"] },
          "new_offset_range": { "type": ["string", "null"] },
          "overlapping_files_old": { "type": "array", "items": { "type": "string" } },
          "overlapping_files_new": { "type": "array", "items": { "type": "string" } },
          "overlap_confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "inference_method": { "type": "string" }
        }
      }
    },
    "movement_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["old_fragment", "new_fragment", "moved_files", "movement_ratio"],
        "properties": {
          "old_fragment": { "type": "string" },
          "new_fragment": { "type": "string" },
          "moved_files": { "type": "array", "items": { "type": "string" } },
          "movement_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "blast_radius": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_file", "impacted_fragments", "impacted_files", "estimated_reuse_loss", "impact_score"],
        "properties": {
          "source_file": { "type": "string" },
          "impacted_fragments": { "type": "array", "items": { "type": "string" } },
          "impacted_files": { "type": "array", "items": { "type": "string" } },
          "estimated_reuse_loss": { "type": "number", "minimum": 0, "maximum": 100 },
          "impact_score": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "reuse_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_path", "old_fragment", "new_fragment", "file_size", "importance_score", "reason"],
        "properties": {
          "file_path": { "type": "string" },
          "old_fragment": { "type": "string" },
          "new_fragment": { "type": "string" },
          "file_size": { "type": "integer", "minimum": 0 },
          "importance_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "reason": { "type": "string" }
        }
      }
    },
    "root_causes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_path", "category", "confidence", "details"],
        "properties": {
          "file_path": { "type": "string" },
          "category": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "details": { "type": "string" }
        }
      }
    },
    "heatmap_data": {
      "type": "object",
      "required": ["fragment_churn", "movement", "impact", "reuse"],
      "properties": {
        "fragment_churn": { "type": "array", "items": { "type": "object" } },
        "movement": { "type": "array", "items": { "type": "object" } },
        "impact": { "type": "array", "items": { "type": "object" } },
        "reuse": { "type": "array", "items": { "type": "object" } }
      }
    },
    "executive_summary": {
      "type": "object",
      "required": [
        "totals",
        "top_20_most_disruptive_files",
        "top_20_most_changed_fragments",
        "largest_blast_radius",
        "estimated_reuse_loss",
        "top_reuse_opportunities"
      ],
      "properties": {
        "totals": { "type": "object" },
        "top_20_most_disruptive_files": { "type": "array", "items": { "type": "object" } },
        "top_20_most_changed_fragments": { "type": "array", "items": { "type": "object" } },
        "largest_blast_radius": { "type": ["object", "null"] },
        "estimated_reuse_loss": { "type": "number", "minimum": 0, "maximum": 100 },
        "top_reuse_opportunities": { "type": "array", "items": { "type": "object" } }
      }
    },
    "parser_validation": {
      "type": "object",
      "required": ["parsed_files", "parsed_fragments", "source_records", "parser_assumptions", "confidence_level"],
      "properties": {
        "parsed_files": { "type": "array", "items": { "type": "object" } },
        "parsed_fragments": { "type": "array", "items": { "type": "object" } },
        "source_records": { "type": "array", "items": { "type": "object" } },
        "parser_assumptions": { "type": "array", "items": { "type": "string" } },
        "confidence_level": { "type": "string" },
        "parser_diagnostics": {
          "type": "object",
          "properties": {
            "old": { "type": "object" },
            "new": { "type": "object" }
          }
        }
      }
    },
    "data_confidence": {
      "type": "object",
      "required": ["level", "has_real_file_paths", "has_fragment_membership", "synthetic_only"],
      "properties": {
        "level": { "type": "string" },
        "has_real_file_paths": { "type": "boolean" },
        "has_fragment_membership": { "type": "boolean" },
        "synthetic_only": { "type": "boolean" },
        "membership_status": { "type": "string" }
      }
    },
    "relationship_graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "items": { "type": "object" } },
        "edges": { "type": "array", "items": { "type": "object" } }
      }
    },
    "debug_dataset": {
      "type": "object",
      "required": ["files", "fragments", "blocks", "extents", "relationships", "source_records", "parser_assumptions", "offset_analysis"],
      "properties": {
        "files": { "type": "array", "items": { "type": "object" } },
        "fragments": { "type": "array", "items": { "type": "object" } },
        "blocks": { "type": "array", "items": { "type": "object" } },
        "extents": { "type": "array", "items": { "type": "object" } },
        "relationships": { "type": "array", "items": { "type": "object" } },
        "source_records": { "type": "array", "items": { "type": "object" } },
        "parser_assumptions": { "type": "array", "items": { "type": "string" } },
        "offset_analysis": { "type": "object" },
        "parser_diagnostics": { "type": "object" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "offset_analysis": {
      "type": "object",
      "required": [
        "storage_timeline",
        "offset_movement",
        "fragment_offset_diff",
        "image_shift_analysis",
        "largest_offset_cascades",
        "downstream_movement_sources"
      ],
      "properties": {
        "storage_timeline": { "type": "object" },
        "offset_movement": { "type": "array", "items": { "type": "object" } },
        "fragment_offset_diff": { "type": "array", "items": { "type": "object" } },
        "image_shift_analysis": { "type": "object" },
        "largest_offset_cascades": { "type": "array", "items": { "type": "object" } },
        "downstream_movement_sources": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
